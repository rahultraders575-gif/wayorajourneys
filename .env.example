# ==============================================================================
# Wayora Journeys - Red Edition: Production Environment Configuration
# Copy this file to .env in production and configure your credentials.
# ==============================================================================

# ----------------- 1. SERVER & HOSTING -----------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=https://wayorajourneys.com

# ----------------- 2. AI CONCIERGE (GOOGLE GEMINI) -----------------
# Get your API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------- 3. DATABASE (POSTGRESQL / SUPABASE / NEON) -----------------
# For persistent production storage beyond in-memory synchronization
DATABASE_URL=postgresql://user:password@host:5432/wayora_production

# ----------------- 4. WHATSAPP BUSINESS API (META CLOUD API) -----------------
# Used for booking confirmations, daily offer updates, and OTPs
# Register at developers.facebook.com/docs/whatsapp
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_waba_id

# ----------------- 5. SMS & OTP GATEWAY (MSG91 / FAST2SMS / TWILIO) -----------------
# Used for transactional SMS and passenger OTP logins in India
SMS_PROVIDER=msg91
SMS_AUTH_KEY=your_sms_gateway_key_here
SMS_SENDER_ID=WAYORA
TWILIO_ACCOUNT_SID=your_twilio_sid_if_using_twilio
TWILIO_AUTH_TOKEN=your_twilio_token_if_using_twilio
TWILIO_PHONE_NUMBER=+1234567890

# ----------------- 6. EMAIL DISPATCH (RESEND / SENDGRID / SMTP) -----------------
# Used for passenger invoices, receipts, and weekend tour newsletters
RESEND_API_KEY=re_your_resend_api_key
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_or_smtp_password
SMTP_FROM_EMAIL=concierge@wayorajourneys.com
