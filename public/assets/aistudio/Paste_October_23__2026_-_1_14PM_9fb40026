        navigator.geolocation.getCurrentPosition(
          pos => {
            pickup.value = `Current Location (${pos.coords.latitude.toFixed(3)}, ${pos.coords.longitude.toFixed(3)})`;
          },
          () => {
            pickup.value = "Hyderabad";
          }
        );
      } else {
        pickup.value = "Hyderabad";
      }
    }

    function handleHeroSubmit(e) {
      e.preventDefault();
      const pickup = document.getElementById('pickupInput').value;
      let dest = "";
      if (currentTripType === 'AIRPORT') {
        dest = document.getElementById('airportSelect').value;
      } else {
        dest = document.getElementById('destinationInput').value || "Tirupati";
      }
      const date = document.getElementById('heroDateInput').value;
      const people = document.getElementById('heroPeopleInput').value;

      openBookingModal(`${dest} (${currentTripType.replace('_', ' ')})`);
      document.getElementById('bmPickup').value = pickup;
      document.getElementById('bmDestination').value = dest;
      if (date) document.getElementById('bmDate').value = date;
    }

    function handleCustomPlanSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('custName').value;
      const phone = document.getElementById('custPhone').value;
      const pickup = document.getElementById('custPickup').value;
      const dest = document.getElementById('custDest').value;
      const date = document.getElementById('custDate').value;
      const days = document.getElementById('custDays').value;
      const car = document.getElementById('custCar').value;

      const message = `*Wayora Journeys Custom Trip Request*%0A` +
        `👤 Name: ${encodeURIComponent(name)}%0A` +
        `📞 Phone: ${encodeURIComponent(phone)}%0A` +
        `📍 Pickup: ${encodeURIComponent(pickup)}%0A` +
        `🎯 Destination: ${encodeURIComponent(dest)}%0A` +
        `📅 Date: ${encodeURIComponent(date)} (${days} Days)%0A` +
        `🚗 Car: ${encodeURIComponent(car)}`;

      window.open(`https://wa.me/919182471876?text=${message}`, '_blank');
    }

    // -------------------------------------------------------------
    // 4. MULTI-STEP BOOKING MODAL LOGIC
    // -------------------------------------------------------------
    let modalStep = 1;
    let selectedBookingData = {};

    function openBookingModal(tourTitle = "Trip") {
      modalStep = 1;
      updateModalStepUI();
      document.getElementById('modalHeading').innerText = `Book ${tourTitle}`;
      if (tourTitle && !tourTitle.includes('General') && !tourTitle.includes('CTA') && !tourTitle.includes('Footer')) {
        document.getElementById('bmDestination').value = tourTitle;
      }
      
      // Default tomorrow's date if empty
      const today = new Date();
      today.setDate(today.getDate() + 1);
      const tomorrowStr = today.toISOString().split('T')[0];
      if (!document.getElementById('bmDate').value) {
        document.getElementById('bmDate').value = tomorrowStr;
      }
      
      document.getElementById('bookingModal').classList.remove('hidden');
    }

    function closeBookingModal() {
      document.getElementById('bookingModal').classList.add('hidden');
    }

    function modalNextStep() {
      if (modalStep === 1) {
        const name = document.getElementById('bmName').value.trim();
        const phone = document.getElementById('bmPhone').value.trim();
        const pickup = document.getElementById('bmPickup').value.trim();
        const dest = document.getElementById('bmDestination').value.trim();
        const date = document.getElementById('bmDate').value;

        if (!name || !phone || !dest) {
          alertCustom("Please fill your Name, Phone Number, and Destination to continue.");
          return;
        }

        selectedBookingData.name = name;
        selectedBookingData.phone = phone;
        selectedBookingData.pickup = pickup;
        selectedBookingData.destination = dest;
        selectedBookingData.date = date;
        selectedBookingData.people = document.getElementById('bmPeople').value;

        modalStep = 2;
        updateModalStepUI();
      } else if (modalStep === 2) {
        const selectedCarRadio = document.querySelector('input[name="modalCarRadio"]:checked');
        selectedBookingData.car = selectedCarRadio ? selectedCarRadio.value : "Wagon R / Swift";

        // populate step 3
        document.getElementById('revName').innerText = selectedBookingData.name;
        document.getElementById('revPhone').innerText = selectedBookingData.phone;
        document.getElementById('revPickup').innerText = selectedBookingData.pickup;
        document.getElementById('revDest').innerText = selectedBookingData.destination;
        document.getElementById('revDate').innerText = selectedBookingData.date;
        document.getElementById('revCar').innerText = selectedBookingData.car;

        modalStep = 3;
        updateModalStepUI();
      } else if (modalStep === 3) {
        // Complete booking
        const payType = document.querySelector('input[name="payType"]:checked').value;
        selectedBookingData.payType = payType;
        selectedBookingData.bookingId = 'WY-' + Math.floor(1000 + Math.random() * 9000);

        // Add to simulated admin dashboard
        adminBookings.unshift({
          id: selectedBookingData.bookingId,
          name: selectedBookingData.name,
          route: `${selectedBookingData.pickup} ➔ ${selectedBookingData.destination}`,
          car: selectedBookingData.car,
          date: selectedBookingData.date,
          status: "New"
        });
        renderAdminTable();

        modalStep = 4;
        updateModalStepUI();
        renderSuccessDetails();
      }
    }

    function modalPrevStep() {
      if (modalStep > 1 && modalStep < 4) {
        modalStep--;
        updateModalStepUI();
      }
    }

    function updateModalStepUI() {
      const s1 = document.getElementById('step1Content');
      const s2 = document.getElementById('step2Content');
      const s3 = document.getElementById('step3Content');
      const sSuccess = document.getElementById('stepSuccessContent');

      const tab1 = document.getElementById('stepTab1');
      const tab2 = document.getElementById('stepTab2');
      const tab3 = document.getElementById('stepTab3');

      const prevBtn = document.getElementById('modalPrevBtn');
      const nextBtn = document.getElementById('modalNextBtn');
      const footerNav = document.getElementById('modalFooterNav');

      [s1, s2, s3, sSuccess].forEach(el => el.classList.add('hidden'));

      if (modalStep === 1) {
        s1.classList.remove('hidden');
        tab1.className = "flex-1 py-3 text-emerald-700 border-b-2 border-emerald-600 bg-white";
        tab2.className = "flex-1 py-3 text-slate-400";
        tab3.className = "flex-1 py-3 text-slate-400";
        prevBtn.classList.add('hidden');
        footerNav.classList.remove('hidden');
        nextBtn.innerHTML = `<span>Next: Choose Car</span> <i class="fa-solid fa-arrow-right"></i>`;
      } else if (modalStep === 2) {
        s2.classList.remove('hidden');
        tab1.className = "flex-1 py-3 text-emerald-700";
        tab2.className = "flex-1 py-3 text-emerald-700 border-b-2 border-emerald-600 bg-white";
        tab3.className = "flex-1 py-3 text-slate-400";
        prevBtn.classList.remove('hidden');
        footerNav.classList.remove('hidden');
        nextBtn.innerHTML = `<span>Next: Review & Inclusions</span> <i class="fa-solid fa-arrow-right"></i>`;
      } else if (modalStep === 3) {
        s3.classList.remove('hidden');
        tab1.className = "flex-1 py-3 text-emerald-700";
        tab2.className = "flex-1 py-3 text-emerald-700";
        tab3.className = "flex-1 py-3 text-emerald-700 border-b-2 border-emerald-600 bg-white";
        prevBtn.classList.remove('hidden');
        footerNav.classList.remove('hidden');
        nextBtn.innerHTML = `<span>Confirm Booking</span> <i class="fa-solid fa-check"></i>`;
      } else if (modalStep === 4) {
        sSuccess.classList.remove('hidden');
        footerNav.classList.add('hidden');
      }
    }

    function renderSuccessDetails() {
      const box = document.getElementById('successSummaryBox');
      box.innerHTML = `
        <div class="space-y-1">
          <div><strong class="text-slate-900">BOOKING ID:</strong> ${selectedBookingData.bookingId}</div>
          <div><strong class="text-slate-900">PASSENGER:</strong> ${selectedBookingData.name} (${selectedBookingData.phone})</div>
          <div><strong class="text-slate-900">ROUTE:</strong> ${selectedBookingData.pickup} ➔ ${selectedBookingData.destination}</div>
          <div><strong class="text-slate-900">VEHICLE:</strong> ${selectedBookingData.car}</div>
          <div><strong class="text-slate-900">TRAVEL DATE:</strong> ${selectedBookingData.date}</div>
          <div><strong class="text-slate-900">ADVANCE TYPE:</strong> ${selectedBookingData.payType}</div>
          <div><strong class="text-emerald-700">STATUS:</strong> CONFIRMED IN DISPATCH</div>
        </div>
      `;
    }

    function sendSuccessViaWhatsApp() {
      const msg = `*Wayora Journeys New Booking Confirmation*%0A` +
        `🆔 ID: ${selectedBookingData.bookingId}%0A` +
        `👤 Name: ${encodeURIComponent(selectedBookingData.name)}%0A` +
        `📞 Phone: ${encodeURIComponent(selectedBookingData.phone)}%0A` +
        `📍 Pickup: ${encodeURIComponent(selectedBookingData.pickup)}%0A` +
        `🎯 Destination: ${encodeURIComponent(selectedBookingData.destination)}%0A` +
        `🚗 Car: ${encodeURIComponent(selectedBookingData.car)}%0A` +
        `📅 Date: ${encodeURIComponent(selectedBookingData.date)}%0A` +
        `💳 Advance Option: ${selectedBookingData.payType}%0A` +
        `Please confirm chauffeur details and invoice.`;

      window.open(`https://wa.me/919182471876?text=${msg}`, '_blank');
    }

    function copyBookingDetailsToClipboard() {
      const text = `Wayora Journeys Booking\nID: ${selectedBookingData.bookingId}\nName: ${selectedBookingData.name}\nPhone: ${selectedBookingData.phone}\nFrom: ${selectedBookingData.pickup}\nTo: ${selectedBookingData.destination}\nCar: ${selectedBookingData.car}\nDate: ${selectedBookingData.date}`;
      
      const textArea = document.createElement("textarea");
      textArea.value = text;
      textArea.style.position = "fixed";
      textArea.style.left = "-999999px";
      textArea.style.top = "-999999px";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        document.execCommand('copy');
        const btn = document.getElementById('copyBtnText');
        btn.innerText = "Copied to Clipboard!";
        setTimeout(() => btn.innerText = "Copy booking details", 2500);
      } catch (err) {
        console.error("Copy failed", err);
      }
      document.body.removeChild(textArea);
    }

    function applyCoupon() {
      const val = document.getElementById('bmCouponInput').value.trim();
      const msg = document.getElementById('couponMsg');
      if (val.toUpperCase() === 'WAYORA100' || val.toUpperCase() === 'FREE200') {
        msg.classList.remove('hidden');
      } else {
        alertCustom("Invalid Coupon. Try 'WAYORA100' for ₹200 off.");
      }
    }

    // -------------------------------------------------------------
    // 5. ADMIN / OWNER MODAL LOGIC
    // -------------------------------------------------------------
    function openAdminModal() {
      renderAdminTable();
      document.getElementById('adminModal').classList.remove('hidden');
    }

    function closeAdminModal() {
      document.getElementById('adminModal').classList.add('hidden');
    }

    function renderAdminTable() {
      const tbody = document.getElementById('adminBookingsTable');
      if (!tbody) return;
      tbody.innerHTML = '';
      document.getElementById('admTotalCount').innerText = adminBookings.length;

      adminBookings.forEach((b, idx) => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50";

        let badgeClass = "bg-emerald-100 text-emerald-800";
        if (b.status === "New") badgeClass = "bg-blue-100 text-blue-800";
        if (b.status === "Assigned") badgeClass = "bg-amber-100 text-amber-800";
        if (b.status === "Completed") badgeClass = "bg-slate-100 text-slate-800";

        tr.innerHTML = `
          <td class="p-3 font-semibold text-slate-900">
            ${b.name} <span class="block text-[10px] text-slate-400 font-mono">${b.id}</span>
          </td>
          <td class="p-3 text-slate-700">${b.route}</td>
          <td class="p-3 font-medium text-emerald-700">${b.car}</td>
          <td class="p-3 text-slate-500">${b.date}</td>
          <td class="p-3">
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${badgeClass}">
              ${b.status}
            </span>
          </td>
          <td class="p-3 text-right">
            <button onclick="changeBookingStatus(${idx})" class="text-emerald-600 hover:text-emerald-800 font-bold text-[11px]">
              Next Status →
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function changeBookingStatus(idx) {
      const statuses = ["New", "Assigned", "Confirmed", "Completed"];
      const curr = adminBookings[idx].status;
      const nextIdx = (statuses.indexOf(curr) + 1) % statuses.length;
      adminBookings[idx].status = statuses[nextIdx];
      renderAdminTable();
    }

    function showQuickAddPrompt() {
      const name = prompt("Enter Car Owner / Chauffeur Name:");
      if (name) {
        alertCustom(`Chauffeur ${name} registered to Wayora Journeys dispatch pool.`);
      }
    }

    function adminBackup() {
      alertCustom("Backup created! JSON state stored in browser storage.");
    }

    function adminRestore() {
      alertCustom("System in sync with official Wayora fleet database.");
    }

    function openCorporateQuoteModal() {
      openBookingModal('Corporate Account');
      document.getElementById('bmDestination').value = "Corporate Business Fleet Contract";
    }

    // -------------------------------------------------------------
    // 6. UI HELPERS
    // -------------------------------------------------------------
    function toggleMobileNav() {
      const menu = document.getElementById('mobileMenu');
      const icon = document.getElementById('menuIcon');
      menu.classList.toggle('hidden');
      if (menu.classList.contains('hidden')) {
        icon.className = "fa-solid fa-bars text-xl";
      } else {
        icon.className = "fa-solid fa-xmark text-xl";
      }
    }

    // Custom friendly message toast instead of alert()
    function alertCustom(message) {
      const toast = document.createElement('div');
      toast.className = "fixed top-6 right-6 z-50 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl text-xs font-semibold flex items-center gap-2.5 border border-slate-700 animate-bounce";
      toast.innerHTML = `<i class="fa-solid fa-circle-info text-emerald-400 text-sm"></i> <span>${message}</span>`;
      document.body.appendChild(toast);
      setTimeout(() => {
        toast.remove();
      }, 3500);
    }

    // Set default pickup date in hero
    window.addEventListener('DOMContentLoaded', () => {
      const heroDate = document.getElementById('heroDateInput');
      if (heroDate) {
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        heroDate.value = tomorrow.toISOString().split('T')[0];
      }
      renderPackages('all');
    });
  </script>
</body>
</html>